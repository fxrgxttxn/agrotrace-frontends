{
  "name": "@agrotrace/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design system «Поле»: CSS tokens, self-hosted fonts, base styles and at-* components shared by the React, Angular and Svelte frontends.",
  "style": "./index.css",
  "exports": {
    ".": "./index.css",
    "./index.css": "./index.css",
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./base.css": "./base.css",
    "./components/*": "./components/*",
    "./fonts/*": "./fonts/*",
    "./sprite.svg": "./sprite.svg",
    "./icons/*": "./icons/*",
    "./illustrations/*": "./illustrations/*"
  },
  "scripts": {
    "test": "vitest run",
    "fonts": "node scripts/copy-fonts.ts",
    "build:sprite": "node scripts/build-sprite.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@fontsource/geologica": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/onest": "5.3.1",
    "@types/node": "^22.9.0",
    "typescript": "~5.6.3",
    "vitest": "^2.1.4"
  }
}
