{
  "rule": "BR-10",
  "fn": "shouldCloseRecall",
  "description": "A recall closes automatically once every withdrawal (recall) task attached to it is CONFIRMED. Task statuses are OPEN, CONFIRMED, OVERDUE. An empty task list closes vacuously.",
  "cases": [
    {
      "name": "empty task list - closes automatically (vacuous true)",
      "input": { "taskStatuses": [] },
      "expected": { "close": true }
    },
    {
      "name": "single confirmed task - closes",
      "input": { "taskStatuses": ["CONFIRMED"] },
      "expected": { "close": true }
    },
    {
      "name": "single open task - does not close",
      "input": { "taskStatuses": ["OPEN"] },
      "expected": { "close": false }
    },
    {
      "name": "all confirmed among multiple tasks - closes",
      "input": { "taskStatuses": ["CONFIRMED", "CONFIRMED", "CONFIRMED"] },
      "expected": { "close": true }
    },
    {
      "name": "mix of confirmed and open - does not close",
      "input": { "taskStatuses": ["CONFIRMED", "OPEN"] },
      "expected": { "close": false }
    },
    {
      "name": "mix of confirmed and overdue - does not close",
      "input": { "taskStatuses": ["CONFIRMED", "OVERDUE"] },
      "expected": { "close": false }
    },
    {
      "name": "all overdue - does not close",
      "input": { "taskStatuses": ["OVERDUE", "OVERDUE"] },
      "expected": { "close": false }
    },
    {
      "name": "single overdue task - does not close",
      "input": { "taskStatuses": ["OVERDUE"] },
      "expected": { "close": false }
    },
    {
      "name": "large list all confirmed - closes",
      "input": { "taskStatuses": ["CONFIRMED", "CONFIRMED", "CONFIRMED", "CONFIRMED", "CONFIRMED"] },
      "expected": { "close": true }
    },
    {
      "name": "large list with one open among many confirmed - does not close",
      "input": { "taskStatuses": ["CONFIRMED", "CONFIRMED", "CONFIRMED", "CONFIRMED", "OPEN"] },
      "expected": { "close": false }
    },
    {
      "name": "last task open after confirmed ones - does not close (order irrelevant)",
      "input": { "taskStatuses": ["OPEN", "CONFIRMED", "CONFIRMED"] },
      "expected": { "close": false }
    }
  ]
}
