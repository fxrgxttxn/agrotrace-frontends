{
  "name": "@agrotrace/frontend-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgroTrace Svelte SPA: SvelteKit + adapter-static (ssr off), Svelte 5 runes, the «Поле» design system.",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && vite build && node scripts/csp-bootstrap.mjs build",
    "build:mock": "svelte-kit sync && AGROTRACE_MOCK=1 vite build --mode mock && node scripts/csp-bootstrap.mjs build-mock",
    "preview": "vite preview --host 0.0.0.0",
    "test": "svelte-kit sync && vitest run",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p e2e"
  },
  "dependencies": {
    "@agrotrace/api-client": "workspace:*",
    "@agrotrace/design-system": "workspace:*",
    "@agrotrace/domain": "workspace:*",
    "@agrotrace/i18n": "workspace:*",
    "@agrotrace/validation": "workspace:*",
    "cytoscape": "3.30.2",
    "cytoscape-dagre": "2.5.0",
    "echarts": "5.5.1",
    "uqr": "0.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@agrotrace/mock-api": "workspace:*",
    "@playwright/test": "1.48.2",
    "@redocly/openapi-core": "^1.25.11",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "4.0.4",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/svelte": "^5.2.4",
    "@testing-library/user-event": "14.5.2",
    "@types/cytoscape": "3.21.9",
    "@types/cytoscape-dagre": "2.3.3",
    "@types/node": "^22.9.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsdom": "25.0.1",
    "msw": "2.15.0",
    "svelte": "5.57.1",
    "svelte-check": "^4.1.0",
    "typescript": "~5.6.3",
    "vite": "5.4.21",
    "vitest": "^2.1.4"
  }
}
