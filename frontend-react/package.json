{
  "name": "@agrotrace/frontend-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgroTrace React SPA: Vite, React Router, TanStack Query, the «Поле» design system.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit -p . && vite build",
    "build:mock": "tsc --noEmit -p . && vite build --mode mock",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p e2e"
  },
  "dependencies": {
    "@agrotrace/api-client": "workspace:*",
    "@agrotrace/design-system": "workspace:*",
    "@agrotrace/domain": "workspace:*",
    "@agrotrace/i18n": "workspace:*",
    "@agrotrace/validation": "workspace:*",
    "@hookform/resolvers": "3.9.1",
    "@tanstack/react-query": "5.59.20",
    "cytoscape": "3.30.2",
    "cytoscape-dagre": "2.5.0",
    "echarts": "5.5.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.2",
    "react-router-dom": "6.28.0",
    "uqr": "0.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@agrotrace/mock-api": "workspace:*",
    "@playwright/test": "1.48.2",
    "@redocly/openapi-core": "^1.25.11",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/cytoscape": "3.21.9",
    "@types/cytoscape-dagre": "2.3.3",
    "@types/node": "^22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsdom": "25.0.1",
    "msw": "2.15.0",
    "typescript": "~5.6.3",
    "vite": "5.4.11",
    "vitest": "^2.1.4"
  }
}
