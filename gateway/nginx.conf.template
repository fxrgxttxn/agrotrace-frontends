# Templated at container start by the base image's own docker-entrypoint.d/20-envsubst-on-
# templates.sh (R80): ${GATEWAY_PORT} below is substituted from the container's environment
# (docker-compose.yml sets it from the host's GATEWAY_PORT, default 80) into
# /etc/nginx/nginx.conf — see gateway/Dockerfile. Every other `$name` here is an nginx variable,
# left untouched because no environment variable of that exact (lowercase) name exists.
worker_processes auto;

events {
  worker_connections 1024;
}

http {
  include       mime.types;
  default_type  application/octet-stream;

  sendfile     on;
  tcp_nopush   on;
  keepalive_timeout 65;

  # No query string in the access log (R88 M1): signed file URLs (`exp`, `sig`), the SSE `access_token` and
  # `lastEventId` travel in the query, so the line has the method, the path ($uri) and the protocol only.
  log_format main
    '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
    '$status $body_bytes_sent "$http_referer" "$http_user_agent" rid=$req_id';
  access_log /dev/stdout main;
  error_log  /dev/stderr warn;

  # Correlation id: reuse the client's X-Request-Id when it looks like one we'd generate
  # ourselves (bounded length, safe charset — never logged/forwarded unvalidated); otherwise
  # (absent, too long, or containing anything outside this set) fall back to nginx's own
  # $request_id. Forwarded to backends and echoed on every response.
  map $http_x_request_id $req_id {
    default                     $request_id;
    "~^[A-Za-z0-9._-]{1,64}$"   $http_x_request_id;
  }

  # $front / $back: parsed once from Host, reused by every location below. Unmatched hosts (the
  # default_server, e.g. unknown *.localhost or bare "localhost") get "" for both.
  map $host $front {
    ~^(?<f>react|angular|svelte)-(express|django|laravel)\.localhost$ $f;
    default '';
  }
  map $host $back {
    ~^(react|angular|svelte)-(?<b>express|django|laravel)\.localhost$ $b;
    default '';
  }

  # --- SPA hosts: {react|angular|svelte}-{express|django|laravel}.localhost -----------------
  server {
    listen 80;
    server_name ~^(react|angular|svelte)-(express|django|laravel)\.localhost$;

    # No backend containers exist when the gateway itself starts (R6/brief): resolve at request
    # time via Docker's embedded DNS instead of nginx resolving api-$back once at startup.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # R34: largest upload is the 10 MB lab protocol; 12 MB leaves headroom for multipart overhead.
    # Anything larger gets nginx's own 413, turned into problem+json by @too_large below.
    client_max_body_size 12m;

    root /srv/$front;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    # Extension point: Yandex Maps will need additions here in a later plan, e.g.
    #   connect-src 'self' https://api-maps.yandex.ru;
    #   img-src 'self' data: blob: https://*.maps.yandex.net;
    #   script-src 'self' https://api-maps.yandex.ru;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; frame-ancestors 'none'" always;
    add_header X-Request-Id $req_id always;

    error_page 413 = @too_large;

    # SSE (R33/R47): no buffering/caching, long read timeout, no Connection: close from keepalive.
    # No proxy_intercept_errors: a real backend's own status codes and bodies (503, 413 with its
    # own params, etc.) must reach the client unchanged. @backend_down only fires for nginx's own
    # synthesized errors (DNS failure / connection refused / timeout to api-$back) — those never
    # go through interception in the first place, intercept or not.
    location /api/v1/events/ {
      proxy_pass http://api-$back:8000;
      proxy_http_version 1.1;
      proxy_set_header Connection '';
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 1h;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $http_host;
      proxy_set_header X-Forwarded-Port ${GATEWAY_PORT};
      proxy_set_header X-Request-Id $req_id;
      # A real backend response already carries its own X-Request-Id / security headers (per
      # contract); hide those so the gateway's own add_header lines above are the single source
      # of truth on the client-facing response, never duplicated.
      proxy_hide_header X-Request-Id;
      proxy_hide_header X-Content-Type-Options;
      proxy_hide_header Referrer-Policy;
      proxy_hide_header Content-Security-Policy;
      # error_page directives on a location REPLACE (not merge with) the server-level ones, so
      # 413 must be repeated here alongside 502/504 (connection failures only — see above).
      error_page 502 504 = @backend_down;
      error_page 413 = @too_large;
    }

    location /api/ {
      proxy_pass http://api-$back:8000;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $http_host;
      proxy_set_header X-Forwarded-Port ${GATEWAY_PORT};
      proxy_set_header X-Request-Id $req_id;
      proxy_hide_header X-Request-Id;
      proxy_hide_header X-Content-Type-Options;
      proxy_hide_header Referrer-Policy;
      proxy_hide_header Content-Security-Policy;
      error_page 502 504 = @backend_down;
      error_page 413 = @too_large;
    }

    # Backend not reachable at all (not started yet, connection refused, DNS failure, timeout):
    # contract ProblemCode BACKEND_UNAVAILABLE. Never reached for a real backend response — with
    # no proxy_intercept_errors, those pass straight through regardless of status code.
    location @backend_down {
      default_type application/problem+json;
      return 502 '{"type":"/problems/backend-unavailable","title":"Backend unavailable","status":502,"code":"BACKEND_UNAVAILABLE","params":{"backend":"$back"}}';
    }

    # Gateway's own 413 (R34, client_max_body_size 12m = 12582912 bytes): same problem+json shape
    # as a backend-issued one, distinguishable only by params.maxBytes being the gateway's limit.
    location @too_large {
      default_type application/problem+json;
      return 413 '{"type":"/problems/file-too-large","title":"File too large","status":413,"code":"FILE_TOO_LARGE","params":{"maxBytes":12582912}}';
    }

    # index.html: never cached (it names the current hashed assets).
    location = /index.html {
      add_header X-Frontend $front always;
      add_header Cache-Control 'no-cache' always;
      add_header X-Content-Type-Options nosniff always;
      add_header Referrer-Policy same-origin always;
      add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; frame-ancestors 'none'" always;
      add_header X-Request-Id $req_id always;
      try_files /index.html =404;
    }

    # Hashed build assets: safe to cache for a year (Vite/Angular/Svelte all hash filenames).
    location /assets/ {
      add_header X-Frontend $front always;
      add_header Cache-Control 'public, max-age=31536000, immutable' always;
      add_header X-Content-Type-Options nosniff always;
      add_header Referrer-Policy same-origin always;
      add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; frame-ancestors 'none'" always;
      add_header X-Request-Id $req_id always;
      try_files $uri =404;
    }

    # Everything else: static file if it exists, otherwise the SPA shell (client-side routing).
    location / {
      add_header X-Frontend $front always;
      add_header X-Content-Type-Options nosniff always;
      add_header Referrer-Policy same-origin always;
      add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; frame-ancestors 'none'" always;
      add_header X-Request-Id $req_id always;
      try_files $uri $uri/ /index.html;
    }
  }

  # --- default_server: unknown hosts, http://localhost/ start page, /_ds/ showcase ----------
  server {
    listen 80 default_server;
    server_name localhost;

    resolver 127.0.0.11 valid=10s ipv6=off;

    root /srv/start;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; frame-ancestors 'none'" always;
    add_header X-Request-Id $req_id always;

    error_page 413 = @too_large;

    location @too_large {
      default_type application/problem+json;
      return 413 '{"type":"/problems/file-too-large","title":"File too large","status":413,"code":"FILE_TOO_LARGE","params":{"maxBytes":12582912}}';
    }

    # Polled by start.js every 10 s; proxies to the real liveness check so the chip reflects
    # whether api-<back> is actually up, not just whether the gateway itself is running. No
    # proxy_intercept_errors: a real (unhealthy) response passes through as-is; only a genuine
    # connection failure is rewritten to the fixed {"status":"fail"} body below.
    location ~ ^/_health/(express|django|laravel)$ {
      set $b $1;
      proxy_pass http://api-$b:8000/api/v1/health/live;
      proxy_set_header Host $host;
      proxy_hide_header X-Request-Id;
      proxy_hide_header X-Content-Type-Options;
      proxy_hide_header Referrer-Policy;
      proxy_hide_header Content-Security-Policy;
      error_page 502 504 = @down;
    }

    location @down {
      default_type application/json;
      return 503 '{"status":"fail"}';
    }

    # Design-system showcase, served read-only from a bind mount (packages/design-system) —
    # narrowed to exactly what the showcase needs at runtime (showcase pages, the composed CSS and
    # the individual files it @imports, self-hosted fonts, the icon sprite + its manifest,
    # illustrations). Everything else under packages/design-system (node_modules, scripts, test,
    # package.json, README, the raw per-icon SVGs already baked into sprite.svg) is not exposed.
    location = /_ds/ {
      return 302 /_ds/showcase/index.html;
    }

    location /_ds/showcase/ {
      alias /srv/ds/showcase/;
    }

    location = /_ds/index.css {
      alias /srv/ds/index.css;
    }

    location = /_ds/tokens.css {
      alias /srv/ds/tokens.css;
    }

    location = /_ds/fonts.css {
      alias /srv/ds/fonts.css;
    }

    location = /_ds/base.css {
      alias /srv/ds/base.css;
    }

    location /_ds/components/ {
      alias /srv/ds/components/;
    }

    location /_ds/fonts/ {
      alias /srv/ds/fonts/;
    }

    location = /_ds/sprite.svg {
      alias /srv/ds/sprite.svg;
    }

    location /_ds/illustrations/ {
      alias /srv/ds/illustrations/;
    }

    # Only file under icons/ the showcase actually fetches at runtime (icons.html's icon grid);
    # the raw per-icon SVGs are already inlined into sprite.svg above.
    location = /_ds/icons/manifest.json {
      alias /srv/ds/icons/manifest.json;
    }

    location /_ds/ {
      return 404;
    }

    location / {
      try_files $uri $uri/ /index.html;
    }
  }
}
