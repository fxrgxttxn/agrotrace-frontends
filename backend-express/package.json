{
  "name": "@agrotrace/backend-express",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgroTrace backend on Express (Plan 1): api, worker and scheduler processes from one image.",
  "scripts": {
    "build": "node build.mjs",
    "dev:api": "tsx watch src/main-api.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "gen:db-types": "kysely-codegen --dialect postgres --date-parser string --numeric-parser string --url \"$DATABASE_URL\" --out-file \"${DB_TYPES_OUT:-src/db/types.generated.ts}\""
  },
  "dependencies": {
    "@agrotrace/domain": "workspace:*",
    "@agrotrace/i18n": "workspace:*",
    "@agrotrace/validation": "workspace:*",
    "@aws-sdk/client-s3": "^3.700.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/onest": "5.3.1",
    "amqplib": "^0.10.5",
    "argon2": "^0.41.1",
    "busboy": "^1.6.0",
    "dompurify": "^3.2.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "jsdom": "^25.0.1",
    "kysely": "^0.27.5",
    "nodemailer": "^6.9.16",
    "otplib": "^12.0.1",
    "pdfkit": "^0.15.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "swagger-ui-dist": "^5.18.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@redocly/openapi-core": "^1.25.11",
    "@types/amqplib": "^0.10.5",
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.5",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.24.0",
    "kysely-codegen": "^0.17.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vitest": "^2.1.4"
  }
}
