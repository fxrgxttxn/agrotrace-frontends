# Merge convention (SP3): per-backend variables go only inside `# --- <backend> (plan N) ---` … `# --- end <backend> ---`.
POSTGRES_USER=agrotrace_owner
POSTGRES_PASSWORD=owner_dev_pw
POSTGRES_DB=agrotrace
APP_DB_USER=agrotrace_app
APP_DB_PASSWORD=app_dev_pw
DATABASE_URL=postgres://agrotrace_owner:owner_dev_pw@postgres:5432/agrotrace?sslmode=disable
APP_DATABASE_URL=postgres://agrotrace_app:app_dev_pw@postgres:5432/agrotrace
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://agrotrace:rabbit_dev_pw@rabbitmq:5672/
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=agrotrace
S3_SECRET_KEY=minio_dev_pw
S3_BUCKET=agrotrace
SMTP_HOST=mailpit
SMTP_PORT=1025
JWT_SECRET=dev_only_change_me_32_bytes_minimum_xx
TELEGRAM_BOT_TOKEN=
# The bot users message with `/start <code>` (createTelegramCode `botUsername`), without @.
TELEGRAM_BOT_USERNAME=agrotrace_bot
DADATA_API_KEY=
YANDEX_MAPS_API_KEY=
MERCURY_URL=http://mercury-mock:8080
PUBLIC_BASE_URL=http://react-express.localhost
# Host port the gateway (docker-compose.yml, service `gateway`) publishes 80 on. Override in a
# local, uncommitted .env when 80 is already taken on the machine (e.g. GATEWAY_PORT=8088) — see
# `./at.sh up gateway`, which prints the start page URL with whatever port is actually in use.
GATEWAY_PORT=80
# --- django (plan 3) ---
# --- end django ---
# --- laravel (plan 5) ---
# --- end laravel ---
